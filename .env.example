# Copy to .env and fill in real values. NEVER commit .env.
# .env lives on the host; docker compose reads it at runtime (env_file),
# so `docker compose up --build` never touches or bakes in your secrets.

# Required
GEMINI_API_KEY=
JWT_SECRET=

# Server
# Docker Compose fixes the container PORT at 8080 (host port 8000) and
# overrides any PORT set in .env. For direct npm runs, set PORT in .env if needed;
# server.js defaults to 8000 without it.
# PORT=8000
# TRUST_PROXY=1

# Rate limiting (defaults: 900000 ms window, 10 requests)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=10

# Database (PostgreSQL with SQLite fallback)
# DATABASE_URL=postgresql://user:password@localhost:5432/depthforge
# SUBSCRIPTIONS_DB_PATH=/app/data/subscriptions.db

# S3-Compatible Storage (AWS S3, Cloudflare R2, MinIO)
# S3_BUCKET=depthforge-assets
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_URL=

# Monetization & Stripe Checkout
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STARTER_CREDITS=10
# ADMIN_EMAIL=admin@slcreations.com
