# Copy to .env and fill in real values. NEVER commit .env.
# .env lives on the host; docker compose reads it at runtime (env_file),
# so `docker compose up --build` never touches or bakes in your secrets.

# Required
GEMINI_API_KEY=

# Server
# Docker Compose fixes the container PORT at 8080 (host port 8000) and
# overrides any PORT set in .env. For direct npm runs, set PORT in .env if needed;
# server.js defaults to 8000 without it.
# PORT=8000
# TRUST_PROXY=1

# Rate limiting (defaults: 900000 ms window, 10 requests)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=10

# Subscriptions DB (persisted on the app_data volume in docker compose)
# SUBSCRIPTIONS_DB_PATH=/app/data/subscriptions.db
